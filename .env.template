# ─────────────────────────────────────────────────────────────────────────────
# .env.template — Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# ── Optional overrides (defaults shown; uncomment only what you need) ────────
# GROQ_MODEL=openai/gpt-oss-20b
# RAG_INDEX_PATH=/tmp/faiss_index
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOKENIZER defaults to RAG_EMBEDDING_MODEL, set it to use a different one
# RAG_PERSIST_INDEX=1
# RAG_CHUNK_SIZE=256
# RAG_CHUNK_OVERLAP=32
# RAG_RETRIEVER_K=4
# RAG_MAX_DISTANCE=1.4
# RAG_MEMORY_TURNS=6
# RAG_MAX_PAGES=300
# RAG_MAX_UPLOAD_MB=50
# RAG_LOG_LEVEL=INFO
