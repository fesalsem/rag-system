# Environment
.env
.venv/
venv/
env/

# Streamlit secrets (a developer using the standard Streamlit pattern would
# otherwise commit credentials).
.streamlit/
.streamlit/secrets.toml
secrets.toml

# Vector store (large binary files, user-specific)
vector_store/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# HuggingFace model cache
.cache/
*.bin
*.safetensors

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Temp uploads
tmp/
temp/

# Evaluation corpus (downloaded, verified by lock.json) and local caches
evals/corpus/*.pdf
evals/.index/
evals/.judge_cache/

# Transient eval output
evals/results/current.json
evals/.answers*.jsonl
