# Never copy secrets or local state into the image.
.env
.env.*

# Streamlit secrets would otherwise be baked into an image layer by COPY . .
.streamlit/
.streamlit/secrets.toml
secrets.toml

.git/
.github/
.gitignore

__pycache__/
*.py[cod]
.venv/
venv/
env/

# The model cache lives in a named volume. The index does not belong in the
# image either: it is per session and never read back.
vector_store/
.cache/
*.bin
*.safetensors

tmp/
temp/
*.log

# Local test artifacts, which COPY . . would otherwise bake into a layer.
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep tests/ and README.md in the image so the suite can be run inside it.
